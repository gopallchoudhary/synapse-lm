{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "TAVILY_API_KEY",
    "PINECONE_API_KEY",
    "PINECONE_INDEX",
    "OPENROUTER_API_KEY",
    "OPENROUTER_BASE_URL",
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "CLOUDINARY_CLOUD_NAME",
    "CLOUDINARY_UPLOAD_PRESET",
    "MEM0_API_KEY",
    "FIRECRAWL_API_KEY",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "NEXT_PUBLIC_API_URL",
    "BASE_URL",
    "PORT",
    "NODE_ENV",
    "SKIP_ENV_VALIDATION",
    "NEXT_PUBLIC_*"
  ],
  "tasks": {
    "generate": {
      "outputs": ["generated/prisma/**"],
      "cache": true
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {},
    "db:migrate": {},
    "db:studio": {}
  }
}
