# EC2 server env_file template (docker-compose → nodejs-server `env_file: .env`)
# Copy to ~/synapse-api/.env on EC2 and fill real values. Never commit this file.

# Database (Neon / managed Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# External services
TAVILY_API_KEY=tvly-dev-...
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=synapse-lm
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
FIRECRAWL_API_KEY=fc-...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_UPLOAD_PRESET=ml_default
MEM0_API_KEY=m0-...

# Inngest Cloud (production): INNGEST_DEV unset, INNGEST_EVENT_KEY set
# INNGEST_EVENT_KEY=...
# INNGEST_DEV=1   # only when running the local Inngest dev CLI

# API wiring
PORT=8000
NODE_ENV=production
# Public API base URL (used for OpenAPI docs only)
BASE_URL=https://synapsebackend.gopalchoudhary.dev
# Comma-separated allowed browser origins (Vercel web app / custom domain)
CORS_ORIGIN=https://synapse-lm.gopalchoudhary.dev